rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email in ['laiehjwella@gmail.com', 'bhavyasehgal2010@gmail.com']);
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function canDeliverOrders() {
      let userData = getUserData();
      return userData.role == 'both';
    }

    function isValidOrderTransition(oldStatus, newStatus) {
      let validTransitions = {
        'Unassigned': ['Assigned', 'Cancelled'],
        'Assigned': ['PickedUp', 'Cancelled'],
        'PickedUp': ['ArrivedAtApartment', 'Cancelled'],
        'ArrivedAtApartment': ['Delivered', 'Cancelled']
      };
      return oldStatus in validTransitions && newStatus in validTransitions[oldStatus];
    }

    function isDelivererOfOrder() {
      return resource.data.delivererUid == request.auth.uid;
    }

    function getAllowedStatusFields(newStatus) {
      let baseFields = ['status', 'updatedAt'];
      return newStatus == 'Cancelled' ? baseFields.concat(['cancelledAt']) :
             newStatus == 'Delivered' ? baseFields.concat(['deliveredAt']) :
             newStatus == 'PickedUp' ? baseFields.concat(['pickedUpAt']) :
             newStatus == 'ArrivedAtApartment' ? baseFields.concat(['arrivedAtApartmentAt']) :
             baseFields;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        isAdmin()
      );
      allow write: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdmin()
      );
    }

    // Orders
    match /orders/{orderId} {
      allow create: if isAuthenticated() && (
        // Only authenticated users can create orders
        request.resource.data.requesterUid == request.auth.uid &&
        // Ensure required fields are present
        'status' in request.resource.data &&
        'requesterUid' in request.resource.data &&
        'items' in request.resource.data &&
        request.resource.data.status == 'Unassigned'
      );

      allow read: if isAuthenticated() && (
        // Requester can read their own orders
        resource.data.requesterUid == request.auth.uid ||
        // Users with 'both' role can read available orders
        (resource.data.status == 'Unassigned' && canDeliverOrders()) ||
        // Assigned deliverer can read their assigned orders
        isDelivererOfOrder() ||
        // Admin can read all orders
        isAdmin()
      );

      allow update: if isAuthenticated() && (
        // --- Temporarily highly relaxed rule for deliverer update debugging ---
        // The goal is to test if an authenticated user who is the deliverer of the order
        // (resource.data.delivererUid == request.auth.uid) can perform an update.
        // All other conditions (requester, admin, other deliverer actions) and
        // finer-grained checks (isValidOrderTransition, affectedKeys) are removed for this test.
        request.auth.uid == resource.data.delivererUid

        // --- Original more complex rule structure (commented out for this extreme test) ---
        // // Requester can only cancel their unassigned orders
        // (resource.data.requesterUid == request.auth.uid &&
        //  resource.data.status == 'Unassigned' &&
        //  request.resource.data.status == 'Cancelled') ||
        //
        // // Deliverer can update status of their assigned orders
        // (isDelivererOfOrder() && // This is effectively request.auth.uid == resource.data.delivererUid
        //  isValidOrderTransition(resource.data.status, request.resource.data.status)
        //  // && request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'updatedAt', 'arrivedAtApartmentAt', 'pickedUpAt', 'deliveredAt', 'cancelledAt'])
        //  ) ||
        //
        // // Active deliverer can accept unassigned orders
        // (resource.data.status == 'Unassigned' &&
        //  request.resource.data.status == 'Assigned' &&
        //  request.resource.data.delivererUid == request.auth.uid &&
        //  canDeliverOrders()) ||
        //
        // // Admin can update any order
        // isAdmin()
      );

      // Only admin can delete orders
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Deny access to any other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
